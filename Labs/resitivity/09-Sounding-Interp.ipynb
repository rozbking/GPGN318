  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3179ec9b",
   "metadata": {},
   "outputs": [],
   "source": [
    "layer_depth = 5                         # depth to the top of the thin layer (m)\n",
    "layer_rho = 2                           # resistivity of the thin layer (Ω·m)\n",
    "thin_thicknesses = [4, 2, 1, 0.5, 0.25]   # <-- thicknesses to try (m)\n",
    "\n",
    "base = predict(best_2_thick, best_2_rho)\n",
    "models, labels = [(best_2_thick, best_2_rho)], ['No thin layer']\n",
    "for h in thin_thicknesses:\n",
    "    t, r = add_thin_layer(best_2_thick, best_2_rho, layer_depth, h, layer_rho)\n",
    "    change = np.max(np.abs(predict(t, r) - base) / base) * 100\n",
    "    status = 'visible' if change > NOISE_PERCENT else 'INVISIBLE (smaller than the noise)'\n",
    "    print(f'thickness = {h:5.2f} m   thickness/depth = {h/layer_depth:4.2f}   curve changes by {change:5.1f} %   -> {status}')\n",
    "    models.append((t, r)); labels.append(f'{h} m thin layer')\n",
    "\n",
    "compare_curves(models, labels, 'Effect of a thin clay layer')"
