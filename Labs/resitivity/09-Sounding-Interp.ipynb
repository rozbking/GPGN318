    "## How this notebook works\n",
    "* You will **not** need to write code. Each step tells you exactly which numbers to change.\n",
    "* Questions are marked **Q1, Q2, ...**. So you should be able to follow the notebook top to bottom and answer each of them sequentially in your report.\n",
    "* Models are always written as two lists (described below), from the surface down:\n",
    "    * `thicknesses`: the thickness of each layer in meters. The bottom layer is a half space so it goes on forever, so this list is always **one shorter** than the resistivity list. This means that the columns (thick. and resist.) will be uneven in length. \n",
    "    * `resistivities`: the resistivity of each layer in Ω·m.\n",
    "\n",
    "For example, 3 m of 20 Ω·m sitting on top of 6 Ω·m is:\n",
    "```\n",
    "thicknesses = [3]\n",
    "resistivities = [20, 6]\n",
    "```"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ab8649e6",
   "metadata": {},
   "source": [
    "## Step 0: Setup\n",
    "Run the cell below. It should load your Kafadar data and the plotting tools. You do not need to open or edit it. You should see the message \"Setup complete.\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "31a3fdd0",
   "metadata": {
    "jupyter": {
     "source_hidden": true
    }
   },
   "outputs": [],
   "source": [
    "# ---- Setup: you do not need to edit anything in this cell ----\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.optimize import least_squares\n",
    "from matplotlib.ticker import FuncFormatter, LogLocator\n",
    "from simpeg.electromagnetics.static import resistivity as dc\n",
    "from simpeg.electromagnetics.static import utils as static_utils\n",
    "\n",
    "NOISE_PERCENT = 5   # assumed data uncertainty (%), see Step 1\n",
    "\n",
    "# Load the Kafadar sounding (V/I in ohms)\n",
    "_kaf = pd.read_csv('data/kafadar_sounding.csv')\n",
    "AB2 = _kaf['AB/2'].values\n",
    "MN2 = _kaf['MN/2'].values\n",
    "_VI = _kaf['V/I'].values\n",
    "\n",
    "def _make_survey(ab2, mn2):\n",
    "    srcs = []\n",
    "    for a, m in zip(ab2, mn2):\n",
    "        rx = dc.receivers.Dipole(np.r_[-m, 0., 0.], np.r_[m, 0., 0.], data_type='volt')\n",
    "        srcs.append(dc.sources.Dipole([rx], np.r_[-a, 0., 0.], np.r_[a, 0., 0.]))\n",
    "    return dc.Survey(srcs)\n",
    "\n",
    "_SURVEY = _make_survey(AB2, MN2)\n",
    "_G = static_utils.geometric_factor(_SURVEY)\n",
    "RHO_DATA = _VI / _G                      # observed apparent resistivity (ohm m)\n",
    "_STD = RHO_DATA * NOISE_PERCENT / 100\n",
    "_MAXZ = 2 * AB2.max()                    # deepest depth shown on plots\n",
    "\n",
    "def predict(thicknesses, resistivities):\n",
    "    \"\"\"Apparent resistivity (ohm m) your model predicts at each AB/2.\"\"\"\n",
    "    sim = dc.Simulation1DLayers(survey=_SURVEY, rho=np.asarray(resistivities, float),\n",
    "                                thicknesses=np.asarray(thicknesses, float))\n",
    "    return sim.dpred(None) / _G\n",
    "\n",
    "def misfit(thicknesses, resistivities):\n",
    "    r = (predict(thicknesses, resistivities) - RHO_DATA) / _STD\n",
    "    return np.mean(r ** 2)\n",
    "\n",
    "def _verdict(m):\n",
    "    if m > 3:\n",
    "        return 'POOR fit: the model does not match the data within the noise.'\n",
    "    if m > 1.5:\n",
    "        return 'CLOSE: getting there, but not yet within the noise.'\n",
    "    if m >= 0.5:\n",
    "        return 'GOOD fit: the model matches the data about as well as the noise allows.'\n",
    "    return 'VERY tight fit: better than the noise. You may be fitting noise.'\n",
    "\n",
    "def _nice_log_axes(ax):\n",
    "    \"\"\"Plain-number tick labels on log axes (e.g. 2, 5, 10, 20 instead of 2x10^0).\"\"\"\n",
    "    for axis in (ax.xaxis, ax.yaxis):\n",
    "        axis.set_major_locator(LogLocator(base=10, subs=(1.0, 2.0, 5.0)))\n",
    "        axis.set_major_formatter(FuncFormatter(lambda v, _: f'{v:g}'))\n",
    "        axis.set_minor_formatter(FuncFormatter(lambda v, _: ''))\n",
    "\n",
    "def _model_xy(thicknesses, resistivities):\n",
    "    tops = np.r_[0, np.cumsum(thicknesses)]\n",
    "    bots = np.r_[np.cumsum(thicknesses), np.inf]\n",
    "    x, y = [], []\n",
    "    for r, t, b in zip(resistivities, tops, bots):\n",
    "        if t >= _MAXZ:\n",
    "            break\n",
    "        x += [r, r]; y += [max(t, 0.1), min(b, _MAXZ)]\n",
    "    return x, y\n",
    "\n",
    "def _plot_data(ax):\n",
    "    ax.errorbar(RHO_DATA, AB2, xerr=_STD, fmt='k^', ms=6, capsize=2, label='Your data')\n",
    "    ax.set_xscale('log'); ax.set_yscale('log')\n",
    "    ax.set_ylim(_MAXZ, 0.5)\n",
    "    ax.set_xlabel('Apparent resistivity (Ω·m)')\n",
    "    ax.set_ylabel('AB/2 (m)')\n",
    "    ax.grid(True, which='both', alpha=0.3)\n",
    "    _nice_log_axes(ax)\n",
    "\n",
    "def plot_data():\n",
    "    \"\"\"Plot your sounding curve.\"\"\"\n",
    "    fig, ax = plt.subplots(figsize=(5, 6))\n",
    "    _plot_data(ax)\n",
    "    ax.set_title('Kafadar sounding curve')\n",
    "    ax.legend()\n",
    "    plt.show()\n",
    "\n",
    "def show_model(thicknesses, resistivities):\n",
    "    \"\"\"Show your model (left) and how its prediction compares with your data (right).\"\"\"\n",
    "    if len(thicknesses) != len(resistivities) - 1:\n",
    "        print('Check your lists: thicknesses must have ONE fewer number than resistivities.')\n",
    "        return\n",
    "    pred = predict(thicknesses, resistivities)\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 6))\n",
    "    x, y = _model_xy(thicknesses, resistivities)\n",
    "    ax1.plot(x, y, 'b-', lw=3)\n",
    "    ax1.set_xscale('log'); ax1.set_yscale('log')\n",
    "    ax1.set_ylim(_MAXZ, 0.5)\n",
    "    ax1.set_xlim(min(min(x), RHO_DATA.min()) / 2, max(max(x), RHO_DATA.max()) * 2)\n",
    "    ax1.set_xlabel('True resistivity (Ω·m)')\n",
    "    ax1.set_ylabel('Depth (m)')\n",
    "    ax1.set_title('Your model')\n",
    "    ax1.grid(True, which='both', alpha=0.3)\n",
    "    _nice_log_axes(ax1)\n",
    "    _plot_data(ax2)\n",
    "    ax2.plot(pred, AB2, 'r-', lw=2, label=\"Your model's prediction\")\n",
    "    ax2.set_xlim(ax1.get_xlim())\n",
    "    ax2.set_title(\"Data vs. your model's prediction\")\n",
    "    ax2.legend()\n",
    "    plt.tight_layout(); plt.show()\n",
    "    m = misfit(thicknesses, resistivities)\n",
    "    print(f'Misfit = {m:.2f}   (aim for about 1)')\n",
    "    print(_verdict(m))\n",
    "\n",
    "def invert(thicknesses, resistivities):\n",
    "    \"\"\"Let the computer fine-tune your model, starting from your guess.\"\"\"\n",
    "    nl = len(resistivities)\n",
    "    x0 = np.log(np.r_[resistivities, thicknesses].astype(float))\n",
    "    lo = np.r_[np.full(nl, np.log(0.1)), np.full(nl - 1, np.log(0.05))]\n",
    "    hi = np.r_[np.full(nl, np.log(1e4)), np.full(nl - 1, np.log(500))]\n",
    "    x0 = np.clip(x0, lo + 1e-6, hi - 1e-6)\n",
    "    def resid(x):\n",
    "        return (predict(np.exp(x[nl:]), np.exp(x[:nl])) - RHO_DATA) / _STD\n",
    "    sol = least_squares(resid, x0, bounds=(lo, hi))\n",
    "    rho = [round(float(v), 1) for v in np.exp(sol.x[:nl])]\n",
    "    thk = [round(float(v), 2) for v in np.exp(sol.x[nl:])]\n",
    "    print('Best-fitting model:')\n",
    "    print('  thicknesses   =', thk, '(m)')\n",
    "    print('  resistivities =', rho, '(Ω·m)')\n",
    "    if np.sum(thk) > AB2.max():\n",
    "        print('  Note: a layer boundary is deeper than your largest AB/2. Your data cannot really see that deep.')\n",
    "    show_model(thk, rho)\n",
    "    return thk, rho\n",
    "\n",
    "def add_thin_layer(thicknesses, resistivities, top, h, rho_new):\n",
    "    \"\"\"Insert a layer of thickness h (m) and resistivity rho_new, starting at depth top (m).\"\"\"\n",
    "    bounds = list(np.cumsum(thicknesses))\n",
    "    edges = sorted(set([b for b in bounds if b > 0] + [top, top + h]))\n",
    "    def rho_at(z):\n",
    "        return resistivities[int(np.searchsorted(bounds, z))]\n",
    "    tops = [0] + edges\n",
    "    bots = edges + [np.inf]\n",
    "    new_rho = []\n",
    "    for t, b in zip(tops, bots):\n",
    "        mid = t + 1e-6 if np.isinf(b) else (t + b) / 2\n",
    "        new_rho.append(rho_new if top <= mid < top + h else rho_at(mid))\n",
    "    return list(np.diff([0] + edges)), new_rho\n",
    "\n",
    "def compare_curves(models, labels, title, show_data=True):\n",
    "    \"\"\"Plot several models (left) and their predicted curves (right).\"\"\"\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 6))\n",
    "    for (t, r), lab in zip(models, labels):\n",
    "        x, y = _model_xy(t, r)\n",
    "        ax1.plot(x, y, lw=2, label=lab)\n",
    "        ax2.plot(predict(t, r), AB2, lw=2, label=lab)\n",
    "    ax1.set_xscale('log'); ax1.set_yscale('log'); ax1.set_ylim(_MAXZ, 0.5)\n",
    "    ax1.set_xlabel('True resistivity (Ω·m)'); ax1.set_ylabel('Depth (m)')\n",
    "    ax1.set_title('Models'); ax1.grid(True, which='both', alpha=0.3); ax1.legend(fontsize=8)\n",
    "    _nice_log_axes(ax1)\n",
    "    if show_data:\n",
    "        _plot_data(ax2)\n",
    "    else:\n",
    "        ax2.set_xscale('log'); ax2.set_yscale('log'); ax2.set_ylim(_MAXZ, 0.5)\n",
    "        ax2.set_xlabel('Apparent resistivity (Ω·m)'); ax2.set_ylabel('AB/2 (m)')\n",
    "        ax2.grid(True, which='both', alpha=0.3)\n",
    "        _nice_log_axes(ax2)\n",
    "    ax2.set_title(title); ax2.legend(fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "print('Setup complete.')"
   ]
  },
